# ============================================================
#  Sodería - Backend
#  Copiar este archivo como .env y completar los valores.
# ============================================================

# ---------- Servidor ----------
# Puerto HTTP del servidor (por defecto 3000)
PORT=3001

# ---------- Base de datos (MySQL) ----------
# Usado por src/config/database.ts, config/config.js (sequelize-cli) y scripts/
DB_HOST=localhost
DB_PORT=3306
DB_NAME=soderia
DB_USER=root
DB_PASSWORD=

# true para conectar por SSL usando src/config/aiven-ca.pem (ej: Aiven)
DB_SSL=false

# ---------- Autenticación ----------
# OBLIGATORIO. Clave para firmar los JWT (HS256). Usar un valor largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ---------- Frontend ----------
# Origen permitido por CORS. Si se deja vacío se aceptan todos los orígenes.
FRONTEND_URL=http://localhost:4200

# OBLIGATORIO para recuperar contraseña. URL base del frontend;
# el link del email se arma como <FRONTEND_URL_RESET>/restablecer?...
FRONTEND_URL_RESET=http://localhost:4200

# ---------- Email (Gmail SMTP) ----------
# Cuenta que envía los emails de recuperación de contraseña.
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google (requiere 2FA),
# no la contraseña normal de la cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Mercado Pago ----------
# true para habilitar los pagos con Mercado Pago (también requiere MP_ACCESS_TOKEN)
MP_HABILITADO=false
MP_ACCESS_TOKEN=
